# Copy to .env and edit. Never commit .env.

# --- Auth (required in practice) -----------------------------------------
# Leave empty to get a random password printed once at first start.
# Min 8 chars; placeholders are refused.
THUMBMUX_PASSWORD=
# Alternatively read it from a file (Docker/K8s secret):
# THUMBMUX_PASSWORD_FILE=/run/secrets/thumbmux_password
# THUMBMUX_SESSION_DAYS=30

# --- Network --------------------------------------------------------------
# Loopback by default. Do not expose directly; use a TLS reverse proxy.
THUMBMUX_HOST=127.0.0.1
THUMBMUX_PORT=7682
# Behind your own reverse proxy: trust X-Forwarded-For / X-Forwarded-Proto
# (enables the Secure cookie flag over HTTPS).
THUMBMUX_TRUST_PROXY=0
# Force the Secure cookie flag even without a trusted proxy header.
THUMBMUX_COOKIE_SECURE=0
# Extra allowed origins for POST/WebSocket, e.g. https://term.example.com
THUMBMUX_ALLOWED_ORIGINS=

# --- tmux / agents -------------------------------------------------------
THUMBMUX_SESSION=phone
THUMBMUX_WORKDIR=
THUMBMUX_AGENTS=claude,codex,opencode,gemini,aider
# THUMBMUX_TMUX_CONF=./deploy/tmux.conf
# THUMBMUX_DATA_DIR=~/.thumbmux

# --- Voice input (optional, off when URL is empty) -----------------------
# Any OpenAI-compatible /audio/transcriptions endpoint.
THUMBMUX_STT_URL=
THUMBMUX_STT_KEY=
THUMBMUX_STT_MODEL=whisper-1
THUMBMUX_STT_LANGUAGE=

# --- Optional VPN kill-switch (docker-compose.vpn.yml) -------------------
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
THUMBMUX_TMUX_SOCKET=
